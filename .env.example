# Kopiere diese Datei nach `.env` und passe die Werte an. `.env` nie committen.

# --- Allgemein ---------------------------------------------------------------
# Öffentliche Basis-URL der Instanz (für Magic-Links, RSS, Mails).
# Lokal mit `npm run dev`: http://localhost:5173
# Mit Docker Compose: leer lassen → https://<DOMAIN>
ORIGIN=http://localhost:5173

# --- Docker Compose ----------------------------------------------------------
# Domain für Caddy (automatisches HTTPS via Let's Encrypt; „localhost“ = lokale CA)
DOMAIN=localhost
# Host-Ports von Caddy (Standard 80/443)
# HTTP_PORT=80
# HTTPS_PORT=443
# Nächtliches Backup (Cron-Syntax, UTC) und Aufbewahrung in Tagen
# BACKUP_SCHEDULE=30 2 * * *
# BACKUP_KEEP_DAYS=14

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=paperradar
POSTGRES_PASSWORD=paperradar
POSTGRES_DB=paperradar
DATABASE_URL=postgres://paperradar:paperradar@localhost:5432/paperradar
# Nur für Integrationstests (npm test); wird bei jedem Lauf geleert!
TEST_DATABASE_URL=postgres://paperradar:paperradar@localhost:5432/paperradar_test

# --- Auth (Auth.js) ----------------------------------------------------------
# Zufälliger Wert (mind. 32 Zeichen), z. B. `openssl rand -base64 32`.
# Auch der Worker braucht ihn (Abmeldelinks der Wochen-Mail). Ändern macht alle
# Feed-Adressen und Abmeldelinks ungültig.
AUTH_SECRET=
# true, wenn die App hinter einem Reverse-Proxy (Caddy) läuft
AUTH_TRUST_HOST=true

# --- E-Mail (SMTP, für Magic-Links und Wochen-Mail) --------------------------
# Standard: Mailpit aus docker-compose.dev.yml (fängt alle Mails ab, http://localhost:8025).
# Für den Betrieb hier den echten SMTP-Server eintragen (z. B. Port 465 + SMTP_SECURE=true).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Paper-Radar <noreply@example.org>"

# --- Datenquellen ------------------------------------------------------------
# Kontaktadresse für User-Agent und Crossref "polite pool" (mailto-Parameter).
CONTACT_EMAIL=
# OpenAlex API-Key (kostenlos, Pflicht). Wird nur serverseitig verwendet.
OPENALEX_API_KEY=
# Tagesbudget je UTC-Tag. Einzelabrufe kosten laut Doku 0 Credits; das Request-Limit
# begrenzt die Zahl der Abrufe. Ist eines erreicht, pausiert die Anreicherung bis Mitternacht UTC.
OPENALEX_DAILY_CREDIT_BUDGET=1000
OPENALEX_DAILY_REQUEST_LIMIT=2000
# „Gut gerankt“ ab dieser Relevanz (gemerkte Paper werden immer angereichert)
OPENALEX_MIN_RELEVANCE=0.4

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error (debug zeigt u. a. jede Rate-Limiter-Wartezeit)
LOG_LEVEL=info

# --- Ranking -----------------------------------------------------------------
# Halbwertszeit des Aktualitäts-Abfalls in Tagen
RANKING_HALF_LIFE_DAYS=7
