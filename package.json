{
	"name": "paper-radar",
	"version": "0.0.1",
	"description": "Paper-Radar: abonnierbarer, transparent gerankter Feed neuer wissenschaftlicher Paper – ohne Tracking.",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/HenryBehindlooker/Paper-Radar"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-worker.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && npm run check",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:live": "LIVE_TESTS=1 LOG_LEVEL=debug vitest run tests/unit/sources/live.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
		"worker": "tsx --env-file-if-exists=.env src/worker.ts",
		"job": "tsx --env-file-if-exists=.env scripts/enqueue.ts",
		"start": "node build",
		"start:worker": "node dist/worker.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.5",
		"@types/nodemailer": "7.0.12",
		"@types/pg": "8.23.1",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tslib": "2.8.1",
		"tsx": "4.23.15",
		"typescript": "~5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "1.11.3",
		"@auth/sveltekit": "1.11.3",
		"drizzle-orm": "0.45.4",
		"fast-xml-parser": "5.11.2",
		"nodemailer": "8.0.11",
		"pg": "8.23.1",
		"pg-boss": "12.38.0"
	},
	"overrides": {
		"is-unsafe": "2.0.2",
		"cron-parser": "5.10.2",
		"serialize-error": "13.0.2",
		"@opentelemetry/api": "1.9.1",
		"jose": "6.2.12",
		"rollup": "4.64.10",
		"postcss": "8.5.31",
		"postcss-selector-parser": "7.1.6",
		"@rollup/pluginutils": "5.4.0",
		"svelte-eslint-parser": "1.9.0",
		"ignore@^7": "7.0.13",
		"@types/estree": "1.0.9",
		"semver@^7": "7.8.5",
		"set-cookie-parser@^3": "3.1.4",
		"svelte": "$svelte",
		"eslint": "$eslint",
		"typescript-eslint": "$typescript-eslint",
		"set-cookie-parser@^2": "2.7.2"
	}
}
