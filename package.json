{
	"name": "paper-radar",
	"version": "0.0.1",
	"description": "Paper-Radar: abonnierbarer, transparent gerankter Feed neuer wissenschaftlicher Paper – ohne Tracking.",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/HenryBehindlooker/Paper-Radar"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && npm run check",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:live": "LIVE_TESTS=1 LOG_LEVEL=debug vitest run tests/unit/sources/live.test.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"fast-xml-parser": "5.11.2"
	},
	"overrides": {
		"is-unsafe": "2.0.2"
	}
}
